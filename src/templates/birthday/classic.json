{
  "id": "birthday-classic",
  "name": "Classic Birthday",
  "description": "Timeless birthday celebration with warm colors and elegant animations",
  "occasion": "birthday",
  "thumbnail": "/templates/birthday-classic.svg",
  "stages": [
    {
      "type": "envelope",
      "enabled": true,
      "props": {
        "style": "sealed-envelope",
        "prompt": "You've got a special surprise!"
      },
      "animation": {
        "type": "fade",
        "duration": 0.8
      }
    },
    {
      "type": "gift-box",
      "enabled": true,
      "props": {
        "style": "ribbon-bow",
        "action": "tap-to-open"
      },
      "animation": {
        "type": "scale",
        "duration": 0.6,
        "delay": 0.3
      }
    },
    {
      "type": "main-content",
      "enabled": true,
      "props": {
        "layout": "scroll",
        "showLetter": true,
        "showPhotos": true
      },
      "animation": {
        "type": "slide-up",
        "duration": 0.5
      }
    },
    {
      "type": "closing",
      "enabled": true,
      "props": {
        "style": "warm-wishes"
      },
      "animation": {
        "type": "fade",
        "duration": 1
      }
    }
  ],
  "theme": {
    "colors": {
      "primary": "#E91E63",
      "secondary": "#F48FB1",
      "accent": "#FF80AB",
      "background": "#FFF0F5",
      "foreground": "#1A1A2E"
    },
    "fonts": {
      "heading": "Playfair Display",
      "body": "Inter"
    },
    "decorations": {
      "style": "balloons",
      "density": "medium"
    }
  }
}
