{
  "id": "birthday-classic",
  "name": "Classic Birthday",
  "description": "Timeless birthday celebration with warm colors and elegant animations",
  "occasion": "birthday",
  "thumbnail": "/templates/birthday-classic.svg",
  "stages": [
    {
      "type": "introduction",
      "enabled": true,
      "props": {},
      "animation": {
        "type": "fade",
        "duration": 0.8
      }
    },
    {
      "type": "start",
      "enabled": true,
      "props": {
        "actionType": "candles",
        "candleCount": 5
      },
      "animation": {
        "type": "fade",
        "duration": 0.8
      }
    },
    {
      "type": "gift-reveal",
      "enabled": true,
      "props": {
        "openMethod": "tap"
      },
      "animation": {
        "type": "scale",
        "duration": 0.6,
        "delay": 0.3
      }
    },
    {
      "type": "gift-opening",
      "enabled": true,
      "props": {},
      "animation": {
        "type": "confetti",
        "duration": 0.7
      }
    },
    {
      "type": "letter",
      "enabled": true,
      "props": {
        "showPhotos": true
      },
      "animation": {
        "type": "slide-up",
        "duration": 0.5
      }
    },
    {
      "type": "photos",
      "enabled": true,
      "props": {},
      "animation": {
        "type": "slide-up",
        "duration": 0.5
      }
    },
    {
      "type": "poem",
      "enabled": true,
      "props": {},
      "animation": {
        "type": "fade",
        "duration": 0.8
      }
    },
    {
      "type": "timeline",
      "enabled": true,
      "props": {},
      "animation": {
        "type": "slide-up",
        "duration": 0.6
      }
    },
    {
      "type": "gift",
      "enabled": true,
      "props": {
        "miniGameType": "spin-wheel",
        "attempts": 3
      },
      "animation": {
        "type": "scale",
        "duration": 0.7
      }
    },
    {
      "type": "closing",
      "enabled": true,
      "props": {
        "style": "warm-wishes"
      },
      "animation": {
        "type": "fade",
        "duration": 1
      }
    }
  ],
  "theme": {
    "colors": {
      "primary": "#E91E63",
      "secondary": "#F48FB1",
      "accent": "#FF80AB",
      "background": "#FFF0F5",
      "foreground": "#1A1A2E"
    },
    "fonts": {
      "heading": "Playfair Display",
      "body": "Inter"
    },
    "decorations": {
      "style": "balloons",
      "density": "medium"
    }
